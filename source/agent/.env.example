# Claude credentials remain on the server. Never copy this value into firmware.
HSHH_PROVIDER_ID=anthropic
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
# Use ANTHROPIC_AUTH_TOKEN instead when required by the selected official
# Anthropic-compatible provider. Do not set both unless that provider requires it.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=sonnet
ANTHROPIC_DEFAULT_HAIKU_MODEL=haiku
ANTHROPIC_DEFAULT_SONNET_MODEL=sonnet
ANTHROPIC_DEFAULT_OPUS_MODEL=opus
# provider_default preserves the selected provider's behavior. Use disabled
# for mixed-thinking models when low-latency companion replies are required.
HSHH_PROVIDER_THINKING_MODE=provider_default
HSHH_PROVIDER_SUPPORTS_VISION=true
HSHH_PROVIDER_SUPPORTS_TOOL_USE=true
HSHH_PROVIDER_SUPPORTS_STRUCTURED_OUTPUT=true
HSHH_PROVIDER_VERIFIED=true

# HTTP service
HSHH_HOST=127.0.0.1
HSHH_PORT=8787
HSHH_CORS_ORIGIN=http://localhost:3000
# API authentication is fail-closed. Configure all four values together and use
# different random tokens for device-originated and user-originated requests.
HSHH_DEVICE_TOKEN=
# Used by the web/panel client for interactions, memory and avatar requests.
HSHH_USER_TOKEN=
# This P0 deployment binds both tokens to exactly one user/device pair.
HSHH_PRINCIPAL_USER_ID=
HSHH_PRINCIPAL_DEVICE_ID=
# Used by the Event & Context Gateway to authenticate short-lived consent.
HSHH_CONSENT_SECRET=

# Optional ESP32-S3 motion-controller LAN transport. Configure both values
# together. Use a private IPv4 address or an mDNS .local hostname and a random
# secret of at least 32 characters; never commit the populated values.
HSHH_MOTION_CONTROLLER_URL=
HSHH_MOTION_SHARED_SECRET=
HSHH_MOTION_TIMEOUT_MS=400

# Optional ESP32-CAM trigger-capture transport. Configure both values together.
# The camera secret must be different from the motion-controller secret.
HSHH_CAMERA_URL=http://hshh-camera.local
HSHH_CAMERA_SHARED_SECRET=
HSHH_CAMERA_TIMEOUT_MS=1500

# Optional isolated VLM for ESP32-CAM perception. This does not replace the
# Claude Agent SDK provider above and is never copied into firmware.
HSHH_VISION_PROVIDER=doubao
HSHH_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
HSHH_DOUBAO_API_KEY=
HSHH_DOUBAO_MODEL=doubao-seed-2-1-turbo-260628
HSHH_DOUBAO_TIMEOUT_MS=5000

# Optional DashScope speech (ASR/TTS) key. Never copy into firmware.
# When HSHH_PROVIDER_ID=qwen and this is empty, the existing DashScope chat
# credential is reused. Never use HSHH_DOUBAO_API_KEY for speech.
DASHSCOPE_API_KEY=
# HSHH_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# Supervised, bounded demo only. Requires the matching ESP32-S3 vision_demo build.
HSHH_ENABLE_VISION_GUIDED_DEMO=false

# Supervised ground walking without HC-SR04 / BNO055. Requires the matching
# ESP32-S3 safe build with HSHH_ALLOW_UNSENSORED_MOTION=1. Consent and stop
# remain required. This does not satisfy PRD 17.1 / 17.2 / 17.6.
HSHH_ALLOW_UNSENSORED_MOTION=false

# Product data. Long-term memory is opt-in per user and defaults to disabled.
HSHH_DATABASE_PATH=./var/hshh.sqlite
HSHH_SESSION_ROOT=./var/sessions
HSHH_SKILLS_ROOT=./.claude/skills
HSHH_AGENT_TIMEOUT_MS=8000
# 12 MiB allows JSON/base64 overhead while decoded pet photos remain capped at 8 MiB.
HSHH_MAX_REQUEST_BYTES=12582912
HSHH_SANDBOX_FAIL_CLOSED=true
HSHH_ALLOWED_WEB_DOMAINS=code.claude.com,github.com,api-docs.deepseek.com,kimi.com,open.bigmodel.cn,help.aliyun.com
HSHH_LOG_LEVEL=info
