{
  "name": "@hshh/agent-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HSHH robot companion agent service",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
